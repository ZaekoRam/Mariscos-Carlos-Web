# Mariscos Carlos — configuración para Hostinger (Apache)
Options -MultiViews
RewriteEngine On
RewriteBase /

# Si el archivo o carpeta existe, se sirve tal cual
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás (/mesero, /cocina, /pedido/..., /qr) lo maneja la app
RewriteRule ^ index.html [L]

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caché larga para archivos con huella (assets/) y corta para index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
